PUBLIC_ADDRESS=rinzler-azahar.duckdns.org
PORT=3000
NODE_ENV=production
ADMIN_TOKEN="change_me_en_tres_long_token_aleatoire"
ADMIN_JWT_EXPIRY=1h

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PGSSLMODE=require

DISCORD_WEBHOOK_URL=

AUTO_BAN_THRESHOLD=3
BANLIST_PATH=/opt/azahar/banlist.txt

ROOM_BINARY=/opt/azahar/azahar-room
ROOM_USERNAME=Rinzler
ROOM_TOKEN="change_me"
ROOM_API_URL=http://127.0.0.1:3000
